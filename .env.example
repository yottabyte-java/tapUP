# WHY: Supply the project root only; Supabase clients append /auth/v1, /rest/v1 and other API paths.
NEXT_PUBLIC_SUPABASE_URL=
# WHY: Public client key is safe to expose only because database access is constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WHY: Privileged server access bypasses RLS; never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# WHY: Authenticates callers of the demo lender API; keep it server-side.
LENDER_API_KEY=
# WHY: Canonical public origin for app links and redirects.
NEXT_PUBLIC_APP_URL=
